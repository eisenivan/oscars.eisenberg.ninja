{
  "rules": {
    "ballots": {
      "$year": {
        ".read": "auth.uid !== null && root.child('settings/' + $year + '/locked').val() === true",
        "$uid": {
          ".read": "auth.uid !== null && ($uid === auth.uid || root.child('settings/' + $year + '/locked').val() === true)",
          ".write": "$uid === auth.uid && root.child('settings/' + $year + '/locked').val() === false"
        }
      }
    },
    "scores": {
      "$uid": {
        ".write": "$uid === auth.uid",
        ".read": "auth.uid !== null"
      }
    },
    "settings": {
      ".read": true,
      ".write": "root.child('admins').child(auth.uid).exists() === true",
      "$year": {
        ".validate": "$year.matches(/^[0-9]{4}$/)"
      }
    },
    "groups": {
      ".read": true,
      "$year": {
        ".write": "root.child('admins').child(auth.uid).exists() === true",
        ".validate": "$year.matches(/^[0-9]{4}$/) && (newData.hasChildren() || !newData.exists())"
      }
    },
    "admins": {
      "$uid": {
        ".read": "$uid === auth.uid || root.child('admins').child(auth.uid).exists() === true",
        ".write": "root.child('admins').child(auth.uid).exists() === true"
      }
    }
  }
}
